# Kopieren nach .env.local und ausfüllen. Werte erzeugen mit: npm run hash-password
# Niemals echte Werte ins Git-Repo.

# Zugangsschutz der App (scrypt-Hash deines App-Passworts)
APP_PASSWORD_HASH=
# Mindestens 32 Zeichen, zufällig
SESSION_SECRET=

# Schlüssel für den verschlüsselten ManagerZone-Zugang (32 Byte, base64)
MZ_TRESOR_KEY=
# Pfad der SQLite-Datenbank (Standard ./data/mz-coach.db)
DATABASE_PATH=./data/mz-coach.db
